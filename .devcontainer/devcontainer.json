{
  // Lab 3.3 - MapReduce and Spark on a mini-cluster of your own.
  // Builds a Codespace with Java 21 + Python 3.13 + PySpark 4.1.3 (the versions the lab was tested with).
  "name": "Lab 3.3 - MapReduce and Spark",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  // 2 cores are enough (the cluster is 1 master + 2 workers x 1 core); 8 GB of RAM are not optional.
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python -m ipykernel install --user --name lab33 --display-name 'Python 3 (lab33)'",
  "forwardPorts": [8080, 4040],
  "portsAttributes": {
    "8080": { "label": "Spark Master UI", "onAutoForward": "silent" },
    "4040": { "label": "Spark application UI", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
